# Optional local demo configuration
# No .env file is required to run the demo locally.
# If this file is omitted, the app uses SQLite via qdrop.db and logs SMS content instead of sending messages.

SECRET_KEY=dev-secret
ENABLE_SMS=false

# Optional PostgreSQL configuration
# SQLALCHEMY_DATABASE_URI=postgresql://username:password@localhost/qdrop_db

# Optional Twilio configuration
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_PHONE_NUMBER=
# PERSONAL_NUMBER=
